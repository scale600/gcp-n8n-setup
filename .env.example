# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Instance Configuration
INSTANCE_NAME=n8n-server
MACHINE_TYPE=e2-micro
DISK_SIZE=30
IMAGE_FAMILY=debian-cloud/debian-11

# Network Configuration
STATIC_IP_NAME=n8n-static-ip
FIREWALL_NAME=allow-n8n
FIREWALL_PORT=5678

# SSH Configuration
SSH_USER=admin
SSH_PRIVATE_KEY_FILE=~/.ssh/id_rsa
SSH_PUBLIC_KEY_FILE=~/.ssh/id_rsa.pub

# n8n Configuration
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
N8N_TIMEZONE=Asia/Seoul
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_SECURE_COOKIE=false

# Current Deployment Info (Auto-populated after deployment)
N8N_SERVER_IP=
N8N_ACCESS_URL=

# Ansible Configuration
ANSIBLE_USER=admin
ANSIBLE_SSH_PRIVATE_KEY_FILE=~/.ssh/id_rsa
ANSIBLE_INVENTORY_FILE=ansible/inventory.ini
